*.jpeg filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text

# The README screenshots have to render wherever the README is read, including places that do not
# resolve LFS pointers, so they stay out of LFS. Every other image (snapshot references) is in LFS.
docs/images/*.png -filter -diff -merge -text
