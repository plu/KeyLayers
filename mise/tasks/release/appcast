#!/usr/bin/env bash
#MISE description="Write the signed Sparkle appcast for a tag release (after mise run release)"
set -euo pipefail

# Writes build/release/appcast.xml for the zip that `mise run release` produced: one item, signed
# with Sparkle's EdDSA key. The release workflow attaches it to the GitHub Release next to the zip,
# where the app's feed URL (.../releases/latest/download/appcast.xml) finds it.
# Not part of the `release` chain: a local release needs no Sparkle key.
#
# Env: RELEASE_TAG (v1.2.3), GITHUB_REPOSITORY (owner/name), SPARKLE_ED_PRIVATE_KEY (fnox).
OUT="${MISE_PROJECT_ROOT}/build/release"
APP="${OUT}/export/KeyLayers.app"
ZIP="${OUT}/KeyLayers.zip"
APPCAST="${OUT}/appcast.xml"
SIGN_UPDATE="${MISE_PROJECT_ROOT}/Tuist/.build/artifacts/sparkle/Sparkle/bin/sign_update"

fail() { echo "error: $*" >&2; exit 1; }

for name in RELEASE_TAG GITHUB_REPOSITORY SPARKLE_ED_PRIVATE_KEY; do
  [ -n "${!name:-}" ] || fail "${name} is not set."
done
[ -f "${ZIP}" ] || fail "${ZIP} not found. Run: mise run release"
[ -d "${APP}" ] || fail "${APP} not found. Run: mise run release"
[ -x "${SIGN_UPDATE}" ] || fail "${SIGN_UPDATE} not found. Run: tuist install"

info="${APP}/Contents/Info.plist"
version="$(plutil -extract CFBundleShortVersionString raw -o - "${info}")"
build="$(plutil -extract CFBundleVersion raw -o - "${info}")"
minimum="$(plutil -extract LSMinimumSystemVersion raw -o - "${info}")"
[ "${RELEASE_TAG}" = "v${version}" ] ||
  fail "tag ${RELEASE_TAG} does not match the app's version ${version}; the build was not made for this tag"
feed="$(plutil -extract SUFeedURL raw -o - "${info}" 2>/dev/null || true)"
[ -n "${feed}" ] || fail "the app has no Sparkle feed URL; it was not built as a tag release"

TMP_DIR="$(mktemp -d)"
trap 'rm -rf "${TMP_DIR}"' EXIT
KEY_FILE="${TMP_DIR}/sparkle.key"
(umask 077 && printf '%s' "${SPARKLE_ED_PRIVATE_KEY}" > "${KEY_FILE}")
# Prints: sparkle:edSignature="..." length="..."
signature_attributes="$("${SIGN_UPDATE}" --ed-key-file "${KEY_FILE}" "${ZIP}")"
[[ "${signature_attributes}" == sparkle:edSignature=*length=* ]] ||
  fail "unexpected sign_update output: ${signature_attributes}"

base="https://github.com/${GITHUB_REPOSITORY}/releases"
cat > "${APPCAST}" <<XML
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>KeyLayers</title>
    <link>${base}</link>
    <item>
      <title>KeyLayers ${version}</title>
      <pubDate>$(LC_ALL=C date -u "+%a, %d %b %Y %H:%M:%S +0000")</pubDate>
      <sparkle:version>${build}</sparkle:version>
      <sparkle:shortVersionString>${version}</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>${minimum}</sparkle:minimumSystemVersion>
      <sparkle:releaseNotesLink>${base}/tag/${RELEASE_TAG}</sparkle:releaseNotesLink>
      <enclosure url="${base}/download/${RELEASE_TAG}/KeyLayers.zip" type="application/octet-stream" ${signature_attributes}/>
    </item>
  </channel>
</rss>
XML
xmllint --noout "${APPCAST}" || fail "${APPCAST} is not well-formed XML"
echo "Created ${APPCAST} for ${version} (${build})"
